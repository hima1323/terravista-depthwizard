.DS_Store
__pycache__/
*.pyc
.claude/
~$*
.synrs3d-upstream.git/
SynRS3D/.venv/
SynRS3D/pretrain/
SynRS3D/data/
SynRS3D/logs/
SynRS3D/snapshot*/
SynRS3D/demo/*/
!SynRS3D/demo/*.py
# benchmark reports are part of the documentation; their caches (predictions, laser photons, tiles) are not
!SynRS3D/demo/benchmark/
SynRS3D/demo/benchmark/*
!SynRS3D/demo/benchmark/*.md
!SynRS3D/demo/benchmark/*_results.json
# the v2 reports the README, TECHNICAL and CLAIMS link to (their cache/ stays out)
!SynRS3D/demo/benchmark/v2/
SynRS3D/demo/benchmark/v2/*
!SynRS3D/demo/benchmark/v2/*.md
!SynRS3D/demo/benchmark/v2/*.json
!SynRS3D/demo/benchmark/v2/*.png

# frontend dependencies (npm install recreates them)
SynRS3D/frontend/node_modules/
SynRS3D/frontend/tsconfig.tsbuildinfo
depthwizard_code.zip

# model weights and exports (100 MB+; GitHub refuses files over 100 MB): share them through Google Drive
*.pth
*.pth.resume
*.onnx
*.zip

# report: the pack holds third-party imagery (Esri / Maxar terms forbid redistribution) and copies of repo docs;
# report/build/ is regenerated by report/build_report.py
DepthWizard_Report_Pack/
report/build/

# local tooling state (Claude Design sync, its staged scripts and output)
.design-sync/
.ds-sync/
ds-bundle/
